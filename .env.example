# Business base location (centre of the 2 km service radius)
NEXT_PUBLIC_BASE_LAT=12.9116
NEXT_PUBLIC_BASE_LNG=77.6389
NEXT_PUBLIC_BASE_NAME="HSR Layout, Bengaluru"
NEXT_PUBLIC_SERVICE_RADIUS_M=2000
NEXT_PUBLIC_SUPPORT_PHONE=+919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Admin dashboard password (change in production!)
ADMIN_PASSWORD=admin123

# When "true", OTP codes are returned in API responses so the flow works without an SMS provider.
OTP_DEV_MODE=true

# Razorpay (optional). Without keys, "Pay Now" uses a simulated checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
