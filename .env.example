# Business base location
NEXT_PUBLIC_BASE_LAT=12.9116
NEXT_PUBLIC_BASE_LNG=77.6389
NEXT_PUBLIC_BASE_NAME="HSR Layout, Bengaluru"
# Service radius in metres; 0 = serve everywhere (default). e.g. 2000 limits bookings to 2 km.
NEXT_PUBLIC_SERVICE_RADIUS_M=0
NEXT_PUBLIC_SUPPORT_PHONE=+916394014604
NEXT_PUBLIC_WHATSAPP_NUMBER=916394014604

# Admin dashboard password (change in production!)
ADMIN_PASSWORD=admin123

# When "true", OTP codes are returned in API responses so the flow works without an SMS provider.
OTP_DEV_MODE=true

# Razorpay (optional). Without keys, "Pay Now" uses a simulated checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shared storage for Vercel / serverless (recommended). Add "Upstash Redis" from the Vercel Marketplace
# (Storage tab) and these are set for you. Without them, Vercel keeps data in /tmp per instance (wiped on cold start).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: secret for signing login cookies (defaults to one derived from ADMIN_PASSWORD)
SESSION_SECRET=

# WhatsApp auto-reply bot (Meta WhatsApp Cloud API). Webhook URL: https://<your-site>/api/whatsapp/webhook
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Google: public site address (auto-detected on Vercel) and Search Console "HTML tag" verification code
NEXT_PUBLIC_SITE_URL=
GOOGLE_SITE_VERIFICATION=
